{
  "name": "realdocs",
  "version": "0.1.0",
  "description": "Generate a Markdown or HTML wiki from source code and its documentation comments.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danbaghilovici/realdocs.git"
  },
  "type": "module",
  "bin": {
    "realdocs": "dist/cli.js"
  },
  "files": [
    "dist/*.js",
    "assets/file-map.css",
    "assets/file-map.js",
    "assets/icon.svg"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "npm run build && node --test"
  },
  "dependencies": {
    "cytoscape": "3.34.3",
    "markdown-it": "15.0.3",
    "mermaid": "11.14.0",
    "micromark": "4.0.2",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/node": "22.20.5"
  }
}
